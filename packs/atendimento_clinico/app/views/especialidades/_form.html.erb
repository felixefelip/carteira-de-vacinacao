<%= form_with(model: especialidade) do |form| %>
  <% if especialidade.errors.any? %>
    <div id="error_explanation">
      <h2>Não foi possível salvar. Corrija os campos abaixo:</h2>
      <ul><% especialidade.errors.each do |error| %><li><%= error.full_message %></li><% end %></ul>
    </div>
  <% end %>
  <div class="form-field">
    <%= form.label :nome, class: "form-label" %>
    <%= form.text_field :nome, class: "form-input", required: true, autofocus: true, placeholder: "Ex.: Cardiologia" %>
  </div>
  <div class="form-actions">
    <%= form.submit class: "btn-primary" %>
    <%= link_to 'Voltar', especialidades_path, class: "link-muted text-sm" %>
  </div>
<% end %>
