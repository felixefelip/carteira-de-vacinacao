<div class="page-header flex flex-wrap items-end justify-between gap-4">
  <div>
    <h1 class="page-title">Tratamentos de <%= Current.pessoa.nome %></h1>
    <p class="page-subtitle">Medicamentos planejados, em uso e encerrados, registrados nas consultas.</p>
  </div>

  <div class="flex flex-wrap gap-2">
    <%= link_to 'Medicamentos', medicamentos_path, class: "btn-secondary" %>
    <%= link_to 'Ver consultas', consultas_path, class: "btn-primary" %>
  </div>
</div>

<%= render 'tabela', prescricoes: @prescricoes, contexto: :tratamentos %>
