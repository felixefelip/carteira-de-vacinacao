<%= render 'cadastros_clinicos/navegacao' %>

<div class="page-header flex flex-wrap items-end justify-between gap-4">
  <div>
    <h1 class="page-title">Estabelecimentos</h1>
    <p class="page-subtitle">Clínicas, consultórios, hospitais e outros locais de atendimento.</p>
  </div>
  <%= link_to 'Cadastrar estabelecimento', new_estabelecimento_path, class: "btn-primary" %>
</div>

<div class="table-wrap">
  <table class="data-table">
    <thead><tr><th scope="col">Estabelecimento</th><th scope="col"><span class="sr-only">Ações</span></th></tr></thead>
    <tbody>
      <% if @estabelecimentos.empty? %>
        <tr><td colspan="2" class="table-empty">Nenhum estabelecimento cadastrado.</td></tr>
      <% end %>
      <% @estabelecimentos.each do |estabelecimento| %>
        <tr>
          <td class="font-medium text-slate-900"><%= estabelecimento.nome %></td>
          <td>
            <div class="flex justify-end">
              <%= link_to 'Editar', edit_estabelecimento_path(estabelecimento), class: "btn-secondary btn-sm" %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
