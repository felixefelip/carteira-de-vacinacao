<% status = recomendacao_vacina.status_vacinal %>
<% idade_recomendada = idade_recomendada_para(recomendacao_vacina) %>

<tr>
  <td class="font-medium text-slate-900"><%= recomendacao_vacina.vacina.descricao %></td>

  <td>
    <span class="badge-count"><%= recomendacao_vacina.qtde_doses_tomadas %></span>
  </td>

  <td>
    <% case status %>
    <% when 'completo' %>
      <span class="badge-success">
        <span class="mr-1.5 size-1.5 rounded-full bg-emerald-500"></span>Completo
      </span>
    <% when 'disponivel' %>
      <span class="badge-warning">
        <span class="mr-1.5 size-1.5 rounded-full bg-amber-500"></span>Disponível
      </span>
      <% if idade_recomendada %>
        <span class="meta">Recomendada: <%= idade_recomendada %></span>
      <% end %>
    <% when 'aguardando' %>
      <span class="badge-neutral">
        <span class="mr-1.5 size-1.5 rounded-full bg-slate-400"></span>Aguardando
      </span>
      <% data_disponivel = recomendacao_vacina.quando_pode_tomar_proxima_dose&.strftime('%d/%m/%Y') %>
      <% if data_disponivel %>
        <span class="meta">Disponível em: <%= data_disponivel %></span>
      <% end %>
      <% if idade_recomendada %>
        <span class="meta">Recomendada: <%= idade_recomendada %></span>
      <% end %>
    <% else %>
      <span class="badge-neutral"><%= status.capitalize %></span>
    <% end %>
  </td>

  <td>
    <div class="flex justify-end">
      <%= link_to 'Cadastrar dose', new_vacina_dose_path(recomendacao_vacina.vacina),
                  class: "btn-secondary btn-sm" %>
    </div>
  </td>
</tr>
