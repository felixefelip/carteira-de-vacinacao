<div class="page-header flex flex-wrap items-end justify-between gap-4">
  <div>
    <h1 class="page-title">Escolha uma vacina</h1>
    <p class="page-subtitle">Selecione a vacina para registrar uma nova dose na sua caderneta.</p>
  </div>

  <%= link_to 'Criar Vacina', new_vacina_path, class: "btn-primary" %>
</div>

<div class="table-wrap">
  <table class="data-table">
    <thead>
      <tr>
        <th scope="col">Vacina</th>
        <th scope="col"><span class="sr-only">Ações</span></th>
      </tr>
    </thead>

    <tbody>
      <% @vacinas.each do |vacina| %>
        <tr>
          <td class="font-medium text-slate-900"><%= vacina.descricao %></td>
          <td>
            <div class="flex justify-end">
              <%= link_to 'Cadastrar dose', new_vacina_dose_path(vacina), class: "btn-secondary btn-sm" %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
