<div class="mx-auto max-w-md">
  <div class="page-header text-center">
    <h1 class="page-title">Entrar</h1>
    <p class="page-subtitle">Acesse a sua carteira de vacinação.</p>
  </div>

  <div class="card-padded">
    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="form-field">
        <%= f.label :email, class: "form-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-input" %>
      </div>

      <div class="form-field">
        <%= f.label :password, "Senha", class: "form-label" %>
        <%= f.password_field :password, autocomplete: "current-password", class: "form-input" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <label class="mb-4 flex items-center gap-2 text-sm text-slate-600">
          <%= f.check_box :remember_me, class: "size-4 rounded border-paper-line text-brand-700 focus:outline-brand-200" %>
          Manter-me conectado
        </label>
      <% end %>

      <%= f.submit "Entrar", class: "btn-primary mt-2 w-full" %>
    <% end %>
  </div>

  <%= render "devise/shared/links" %>
</div>
