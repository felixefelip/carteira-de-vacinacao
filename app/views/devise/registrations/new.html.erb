<div class="mx-auto max-w-md">
  <div class="page-header text-center">
    <h1 class="page-title">Criar sua conta</h1>
    <p class="page-subtitle">Sua caderneta é montada na hora, e depois você pode cadastrar outras pessoas na mesma conta.</p>
  </div>

  <div class="card-padded">
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="form-field">
        <%= f.label :email, class: "form-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-input", required: true %>
      </div>

      <%= f.fields_for :pessoa_titular do |pessoa| %>
        <div class="form-field">
          <%= pessoa.label :nome, "Seu nome", class: "form-label" %>
          <%= pessoa.text_field :nome, class: "form-input", required: true %>
        </div>

        <div class="form-field">
          <%= pessoa.label :data_nascimento, "Sua data de nascimento", class: "form-label" %>
          <%= pessoa.date_field :data_nascimento, class: "form-input", required: true %>
        </div>
      <% end %>

      <div class="form-field">
        <%= f.label :password, "Senha", class: "form-label" %>
        <%= f.password_field :password, autocomplete: "new-password", class: "form-input", required: true %>
        <% if @minimum_password_length %>
          <span class="form-hint">Mínimo de <%= @minimum_password_length %> caracteres.</span>
        <% end %>
      </div>

      <div class="form-field">
        <%= f.label :password_confirmation, "Confirme sua senha", class: "form-label" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-input", required: true %>
      </div>

      <%= f.submit "Cadastrar", class: "btn-primary mt-2 w-full" %>
    <% end %>
  </div>

  <%= render "devise/shared/links" %>
</div>
