<div class="mx-auto max-w-md">
  <div class="page-header text-center">
    <h1 class="page-title">Criar sua conta</h1>
    <p class="page-subtitle">A caderneta e o calendário são montados automaticamente a partir da sua data de nascimento.</p>
  </div>

  <div class="card-padded">
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), local: true, html: { novalidate: false, "data-turbo": false }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="form-field">
        <%= f.label :email, class: "form-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-input", required: true %>
      </div>

      <div class="form-field">
        <%= f.label :data_nascimento, "Data de Nascimento", class: "form-label" %>
        <%= f.date_field :data_nascimento, class: "form-input", required: true %>
      </div>

      <div class="form-field">
        <%= f.label :password, "Senha", class: "form-label" %>
        <%= f.password_field :password, autocomplete: "new-password", class: "form-input", required: true %>
        <% if @minimum_password_length %>
          <span class="form-hint">Mínimo de <%= @minimum_password_length %> caracteres.</span>
        <% end %>
      </div>

      <div class="form-field">
        <%= f.label :password_confirmation, "Confirme sua senha", class: "form-label" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-input", required: true %>
      </div>

      <%= f.submit "Cadastrar", class: "btn-primary mt-2 w-full" %>
    <% end %>
  </div>

  <%= render "devise/shared/links" %>
</div>
