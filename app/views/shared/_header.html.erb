<header class="bg-brand-800">
  <div class="mx-auto flex w-full max-w-5xl flex-col gap-2 px-4 py-3 sm:px-6 md:flex-row md:items-center md:justify-between md:gap-6">
    <%= link_to root_path, class: "flex shrink-0 items-center gap-2.5 text-white no-underline" do %>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6 text-brand-300" aria-hidden="true">
        <path d="M12 3 4.5 6v6c0 4.2 3 7.6 7.5 9 4.5-1.4 7.5-4.8 7.5-9V6L12 3Z" />
        <path d="m9 12 2 2 4-4" />
      </svg>
      <span class="text-base font-semibold tracking-tight">Carteira de Vacinação</span>
    <% end %>

    <nav class="-mx-1 flex w-full flex-wrap items-center gap-1 px-1 md:w-auto md:justify-end" aria-label="Navegação principal">
      <% if user_signed_in? %>
        <% vacinacao = %w[caderneta sugestoes vacinas doses fabricante_vacinas] %>
        <% atendimento_clinico = %w[agendamentos consultas prescricoes medicamentos especialidades profissionais estabelecimentos] %>

        <%= render 'shared/menu_de_navegacao',
                   rotulo: 'Vacinação',
                   descricao: 'Cadernetas, calendário e vacinas',
                   icone: :vacinacao,
                   alinhamento: :left,
                   ativo: vacinacao.include?(controller_name),
                   itens: [
                     { rotulo: 'Caderneta', descricao: 'Doses e histórico vacinal', caminho: caderneta_path, ativo: controller_name == 'caderneta' },
                     { rotulo: 'Calendário', descricao: 'Recomendações por idade', caminho: sugestoes_path, ativo: controller_name == 'sugestoes' },
                     { rotulo: 'Vacinas', descricao: 'Vacinas e fabricantes', caminho: vacinas_path, ativo: %w[vacinas doses fabricante_vacinas].include?(controller_name) }
                   ] %>

        <%= render 'shared/menu_de_navegacao',
                   rotulo: 'Atendimento clínico',
                   descricao: 'Agenda, consultas e prescrições',
                   icone: :atendimento_clinico,
                   alinhamento: :right,
                   ativo: atendimento_clinico.include?(controller_name),
                   itens: [
                     { rotulo: 'Agendamentos', descricao: 'Próximos atendimentos', caminho: agendamentos_path, ativo: controller_name == 'agendamentos' },
                     { rotulo: 'Consultas', descricao: 'Histórico de atendimentos', caminho: consultas_path, ativo: controller_name == 'consultas' },
                     { rotulo: 'Prescrições', descricao: 'Orientações e medicamentos', caminho: prescricoes_path, ativo: controller_name == 'prescricoes' },
                     { rotulo: 'Medicamentos', descricao: 'Cadastro de insumos', caminho: medicamentos_path, ativo: controller_name == 'medicamentos' },
                     { rotulo: 'Cadastros clínicos', descricao: 'Profissionais, especialidades e locais', caminho: profissionais_path, ativo: %w[especialidades profissionais estabelecimentos].include?(controller_name) }
                   ] %>

        <span class="mx-1 hidden h-5 w-px shrink-0 bg-white/20 md:block" aria-hidden="true"></span>

        <%= render 'shared/seletor_de_perfil' %>

        <%= link_to 'Sair', destroy_user_session_path, method: :delete, class: 'nav-link' %>
      <% else %>
        <%= link_to 'Entrar', new_user_session_path, class: 'nav-link' %>
        <%= link_to 'Cadastrar-se', new_user_registration_path,
                    class: 'rounded-md bg-white px-3 py-2 text-sm font-medium text-brand-800 no-underline transition-colors hover:bg-brand-50' %>
      <% end %>
    </nav>
  </div>
</header>
