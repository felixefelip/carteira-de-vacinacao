<% menu_id = "menu-#{icone.to_s.dasherize}" %>
<div class="nav-menu <%= 'nav-menu--active' if ativo %>"
     data-controller="menu-suspenso"
     data-action="mouseleave->menu-suspenso#fechar focusout->menu-suspenso#fecharAoSair click@window->menu-suspenso#fecharAoClicarFora keydown.esc@window->menu-suspenso#fecharComEscape">
  <button type="button"
          id="<%= menu_id %>-trigger"
          class="nav-menu-trigger"
          aria-expanded="false"
          aria-controls="<%= menu_id %>"
          data-menu-suspenso-target="trigger"
          data-action="menu-suspenso#alternar">
    <% if icone == :vacinacao %>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
        <path d="m14.5 5.5 4 4" />
        <path d="m12.5 7.5 4 4" />
        <path d="m4 20 5.5-5.5" />
        <path d="m6.5 17.5-2-2" />
        <path d="m15.5 4.5 4 4-8.25 8.25a2.12 2.12 0 0 1-3 0l-1-1a2.12 2.12 0 0 1 0-3L15.5 4.5Z" />
      </svg>
    <% else %>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
        <path d="M9 5h6" />
        <path d="M9 3h6a1 1 0 0 1 1 1v2H8V4a1 1 0 0 1 1-1Z" />
        <path d="M7 5H5.5A1.5 1.5 0 0 0 4 6.5v13A1.5 1.5 0 0 0 5.5 21h13a1.5 1.5 0 0 0 1.5-1.5v-13A1.5 1.5 0 0 0 18.5 5H17" />
        <path d="M8 12h8M8 16h5" />
      </svg>
    <% end %>

    <span><%= rotulo %></span>

    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="nav-menu-caret" aria-hidden="true">
      <path d="m6 8 4 4 4-4" />
    </svg>
  </button>

  <div id="<%= menu_id %>"
       class="nav-menu-panel <%= 'nav-menu-panel--right' if alinhamento == :right %>"
       aria-labelledby="<%= menu_id %>-trigger">
    <div class="border-b border-paper-line px-4 py-3">
      <p class="text-sm font-semibold text-brand-900"><%= rotulo %></p>
      <p class="mt-0.5 text-xs text-slate-500"><%= descricao %></p>
    </div>

    <div class="p-1.5">
      <% itens.each do |item| %>
        <%= link_to item[:caminho],
                    class: "nav-menu-link #{'nav-menu-link--active' if item[:ativo]}",
                    'aria-current': ('page' if item[:ativo]) do %>
          <span class="font-medium text-slate-800"><%= item[:rotulo] %></span>
          <span class="text-xs text-slate-500"><%= item[:descricao] %></span>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
