<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title>Carteira de Vacinação Digital</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "/assets/application.js", "data-turbo-track": "reload", defer: true %>
    <%= javascript_importmap_tags %>
    <%= javascript_include_tag "turbo", type: "module" %>
  </head>

  <body class="flex min-h-screen flex-col">
    <%= render 'shared/header' %>

    <main class="mx-auto w-full max-w-5xl flex-1 px-4 py-8 sm:px-6">
      <% if notice %>
        <div class="alert-success mb-6" role="status"><%= notice %></div>
      <% end %>

      <% if alert %>
        <div class="alert-error mb-6" role="alert"><%= alert %></div>
      <% end %>

      <%= yield %>
    </main>

    <footer class="mt-auto border-t border-paper-line bg-white">
      <div class="mx-auto flex w-full max-w-5xl flex-col gap-1 px-4 py-6 text-sm text-slate-500 sm:flex-row sm:items-center sm:justify-between sm:px-6">
        <p>Carteira de Vacinação Digital</p>
        <p class="text-xs">Desenvolvido por Felix Tech</p>
      </div>
    </footer>
  </body>
</html>
