<div class="page-header flex flex-wrap items-end justify-between gap-4">
  <div>
    <h1 class="page-title">Caderneta de Vacinação</h1>
    <p class="page-subtitle">Vacinas registradas e o total de doses aplicadas.</p>
  </div>

  <%= link_to "Adicionar Vacinação", vacinas_path, class: "btn-primary" %>
</div>

<div class="table-wrap">
  <table class="data-table">
    <thead>
      <tr>
        <th scope="col">Vacina</th>
        <th scope="col">Doses</th>
        <th scope="col"><span class="sr-only">Ações</span></th>
      </tr>
    </thead>

    <tbody>
      <% if @vacinas.any? %>
        <% @vacinas.each do |vacina| %>
          <%= render 'doses', vacina: vacina %>
        <% end %>
      <% else %>
        <tr>
          <td colspan="3" class="table-empty">
            Nenhuma dose registrada até agora.
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
