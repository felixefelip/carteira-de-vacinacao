<%= form_with(model: vacina, url: vacinas_path) do |form| %>
  <% if vacina.errors.any? %>
    <div id="error_explanation">
      <h2>Não foi possível salvar. Corrija os campos abaixo:</h2>

      <ul>
        <% vacina.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-field">
    <%= form.label :descricao, class: "form-label" %>
    <%= form.text_field :descricao, class: "form-input" %>
  </div>

  <div class="form-actions">
    <%= form.submit class: "btn-primary" %>
    <%= link_to "Voltar", :back, class: "link-muted text-sm" %>
  </div>
<% end %>
