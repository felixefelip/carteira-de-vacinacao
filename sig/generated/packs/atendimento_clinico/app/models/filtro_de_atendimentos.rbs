class FiltroDeAtendimentos
  @data_de: Date?
  @data_ate: Date?

  REFERENCIAS: [ :profissional_id, :especialidade_id, :estabelecimento_id ]

  def initialize: ((Agendamento::ActiveRecord_Relation | Consulta::ActiveRecord_Relation) relacao, nil filtros, coluna_data: (:inicio_em | :realizada_em)) -> void
  def resultado: () -> (Agendamento::ActiveRecord_Relation | Consulta::ActiveRecord_Relation)

  private

  attr_accessor relacao: Agendamento::ActiveRecord_Relation | Consulta::ActiveRecord_Relation
  attr_reader filtros: nil
  attr_reader coluna_data: (:inicio_em | :realizada_em)

  def filtrar_periodo: () -> (Agendamento::ActiveRecord_Relation | Consulta::ActiveRecord_Relation | nil)
  def filtrar_referencias: () -> [ :profissional_id, :especialidade_id, :estabelecimento_id ]
  def filtrar_status: () -> (Agendamento::ActiveRecord_Relation | Consulta::ActiveRecord_Relation)?
  def filtrar_pagamento: () -> (Agendamento::ActiveRecord_Relation | Consulta::ActiveRecord_Relation | nil)
  def data_de: () -> Date?
  def data_ate: () -> Date?
  def converter_data: ((:data_de | :data_ate) chave) -> Date?
end
