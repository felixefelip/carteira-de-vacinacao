class Agendamento < ApplicationRecord
  include Anexavel

  def pago?: () -> bool

  private

  def referencia_clinica_alterada?: () -> untyped
  def especialidade_precisa_ser_do_profissional: () -> ActiveModel::Error?
  def usar_especialidade_do_profissional: () -> Especialidade?

  class AfterPago
    def pago_em: () -> ::Date
  end
end
