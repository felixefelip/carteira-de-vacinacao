class EspecialidadesController < ApplicationController
  @especialidades: Especialidade::ActiveRecord_Relation?
  @especialidade: (Especialidade | (Especialidade & Especialidade::Validated))?

  def index: () -> void
  def new: () -> void
  def edit: () -> void
  def create: () -> void
  def update: () -> void

  private

  def set_especialidade: () -> Especialidade?
  def especialidade_params: () -> (ActionController::Parameters & ActionController::Parameters::Permitted)
end
