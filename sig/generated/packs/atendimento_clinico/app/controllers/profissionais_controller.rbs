class ProfissionaisController < ApplicationController
  @profissionais: Profissional::ActiveRecord_Relation?
  @profissional: (Profissional | (Profissional & Profissional::Validated))?
  @especialidades: Especialidade::ActiveRecord_Relation?

  def index: () -> void
  def new: () -> void
  def edit: () -> void
  def create: () -> void
  def update: () -> void

  private

  def set_profissional: () -> Profissional?
  def carregar_especialidades: () -> Especialidade::ActiveRecord_Relation
  def profissional_params: () -> (ActionController::Parameters & ActionController::Parameters::Permitted)
end
