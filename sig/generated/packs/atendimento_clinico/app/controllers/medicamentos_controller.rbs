class MedicamentosController < ApplicationController
  @medicamentos: Medicamento::ActiveRecord_Relation?
  @medicamento: (Medicamento | (Medicamento & Medicamento::Validated))?
  @consulta: (Consulta & Consulta::Validated)?

  def index: () -> void
  def new: () -> void
  def edit: () -> void
  def create: () -> void
  def update: () -> void

  private

  def set_medicamento: () -> Medicamento?
  def medicamento_params: () -> (ActionController::Parameters & ActionController::Parameters::Permitted)
  def set_consulta_para_retorno: () -> (Consulta & Consulta::Validated)?
  def destino_apos_cadastro: () -> String
end
