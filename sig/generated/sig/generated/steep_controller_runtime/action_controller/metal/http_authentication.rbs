module ActionController
  module HttpAuthentication
    module Token::ControllerMethods
      def authenticate_or_request_with_http_token: (?String realm, ?untyped message) ?{ (*untyped) -> untyped } -> untyped
      def authenticate_with_http_token: () ?{ (*untyped) -> untyped } -> untyped
      def request_http_token_authentication: (?String realm, ?untyped message) -> bool
    end
    module Token
      def authenticate: ((ActionController::Base & ActionController::HttpAuthentication::Token::ControllerMethods) controller) { (untyped, untyped) -> untyped } -> untyped
      def authentication_request: ((ActionController::Base & ActionController::HttpAuthentication::Token::ControllerMethods) controller, untyped realm, ?untyped message) -> bool
    end
  end
end
