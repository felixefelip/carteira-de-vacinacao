module ActiveSupport
  module Concern
    @_included_block: (^(*untyped) -> untyped)?

    def self.extended: (Object base) -> untyped | ...

    def append_features: (Module base) -> bool? | ...
    def class_methods: () ?{ (*untyped) -> untyped } -> untyped | ...
    def included: (?Module? base) ?{ (*untyped) -> untyped } -> ^() -> (^(*untyped) -> untyped)? | ...
  end
end
