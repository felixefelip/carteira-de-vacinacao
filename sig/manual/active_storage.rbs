# Escrito à mão — não sai de nenhum gerador.
#
# O RBS do activestorage no gem_rbs_collection declara `Attached::One` sem os
# delegados que vão parar no blob (é tudo `delegate_missing_to :attachment` em
# tempo de execução) e declara `Blob` sem as colunas. A validação de foto da
# Pessoa usa exatamente esses três, então eles entram aqui.

module ActiveStorage
  class Attached::One < Attached
    def blob: () -> ActiveStorage::Blob?
  end
end

class ActiveStorage::Blob < ActiveStorage::Record
  def content_type: () -> String?
  def byte_size: () -> Integer
end
